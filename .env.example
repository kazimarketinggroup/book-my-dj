# ==========================================
# GMAIL SMTP NOTIFICATION SETTINGS
# ==========================================
# To generate a Gmail App Password:
# 1. Go to your Google Account (myaccount.google.com)
# 2. Navigate to "Security"
# 3. Enable "2-Step Verification" (if not already enabled)
# 4. Search for "App passwords"
# 5. Create an app password named e.g. "Book My DJ"
# 6. Copy the 16-character code and paste it below:

GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-app-password"

# Recipient email where booking inquiries will be delivered.
# If left blank, it defaults to GMAIL_USER.
NOTIFICATION_EMAIL="your-email@gmail.com"
